{
    "name": "macro-vscode",
    "displayName": "macro",
    "description": "VSCode language support for the macro programming language.",
    "version": "0.2.2",
    "publisher": "las-r",
    "repository": {
        "type": "git",
        "url": "https://github.com/las-r/macro-vscode"
    },
    "engines": {
        "vscode": "^1.146.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "macro",
                "aliases": [
                    "macro",
                    "macro"
                ],
                "extensions": [
                    ".mac",
                    ".macro"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "macro",
                "scopeName": "source.macro",
                "path": "./syntaxes/macro.tmLanguage.json"
            }
        ]
    }
}